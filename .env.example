# ============================================================================
# Hotel Sai Aman — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ============================================================================

# --- Database (required for bookings, accounts, admin) -----------------------
# Any PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS, etc.)
DATABASE_URL=

# --- Auth (required) ---------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: set only if you have a fixed canonical URL.
# BETTER_AUTH_URL=https://your-domain.com

# --- Email / SMTP (optional; emails are logged when unset) -------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hotel Sai Aman <no-reply@hotelsaiaman.com>
# Receives new-booking notifications.
ADMIN_EMAIL=

# --- Payments ---------------------------------------------------------------
# 'test' uses the safe in-app sandbox. Set to 'live' + fill gateway keys below
# to enable real payments.
PAYMENT_MODE=test

# eSewa (https://developer.esewa.com.np)
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=

# Khalti (https://docs.khalti.com)
KHALTI_SECRET_KEY=

# Fonepay
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET_KEY=
